{
  "name": "sam-altman-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SamAltman out/sam-altman.mp4",
    "build": "remotion render SamAltman out/sam-altman.mp4 --crf 18",
    "tts:generate": "node scripts/generate-qwen-tts.mjs",
    "tts:generate:force": "node scripts/generate-qwen-tts.mjs --force",
    "tts:generate:qwen": "TTS_PROVIDER=qwen node scripts/generate-qwen-tts.mjs",
    "tts:generate:minimax": "TTS_PROVIDER=minimax node scripts/generate-qwen-tts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.261",
    "@remotion/google-fonts": "4.0.261",
    "@remotion/media-utils": "4.0.261",
    "@remotion/transitions": "4.0.261",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.261"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.0"
  }
}
